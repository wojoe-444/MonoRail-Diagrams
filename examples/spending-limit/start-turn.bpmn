<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_startTurn" targetNamespace="https://monorail.invalid/diagrams/spending-limit">
  <bpmn:collaboration id="collab_startTurn">
    <bpmn:participant id="pool_app" name="MonoRail app" processRef="proc_startTurn" />
  </bpmn:collaboration>
  <bpmn:process id="proc_startTurn" isExecutable="false">
    <bpmn:documentation>Purpose: show how MonoRail decides, before a turn starts, whether the spending limit lets it run. Trigger: a chat turn is requested.</bpmn:documentation>
    <bpmn:startEvent id="evt_turnRequested" name="Turn requested" />
    <bpmn:businessRuleTask id="task_checkSpendingLimit" name="Check spending limit" implementation="spending-limit-action.dmn#dec_spendingLimitAction" />
    <bpmn:exclusiveGateway id="gw_limitAction" name="Limit action?" />
    <bpmn:serviceTask id="task_showWarning" name="Show warning" />
    <bpmn:exclusiveGateway id="gw_actionJoin" />
    <bpmn:serviceTask id="task_runTurn" name="Run turn" />
    <bpmn:endEvent id="evt_turnFinished" name="Turn finished" />
    <bpmn:endEvent id="evt_turnRefused" name="Turn refused" />
    <bpmn:sequenceFlow id="flow_turnRequested_to_checkSpendingLimit" sourceRef="evt_turnRequested" targetRef="task_checkSpendingLimit" />
    <bpmn:sequenceFlow id="flow_checkSpendingLimit_to_limitAction" sourceRef="task_checkSpendingLimit" targetRef="gw_limitAction" />
    <bpmn:sequenceFlow id="flow_limitAction_to_actionJoin" name="allow" sourceRef="gw_limitAction" targetRef="gw_actionJoin" />
    <bpmn:sequenceFlow id="flow_limitAction_to_showWarning" name="warn" sourceRef="gw_limitAction" targetRef="task_showWarning" />
    <bpmn:sequenceFlow id="flow_limitAction_to_turnRefused" name="stop" sourceRef="gw_limitAction" targetRef="evt_turnRefused" />
    <bpmn:sequenceFlow id="flow_showWarning_to_actionJoin" sourceRef="task_showWarning" targetRef="gw_actionJoin" />
    <bpmn:sequenceFlow id="flow_actionJoin_to_runTurn" sourceRef="gw_actionJoin" targetRef="task_runTurn" />
    <bpmn:sequenceFlow id="flow_runTurn_to_turnFinished" sourceRef="task_runTurn" targetRef="evt_turnFinished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_collab_startTurn">
    <bpmndi:BPMNPlane id="plane_collab_startTurn" bpmnElement="collab_startTurn">
      <bpmndi:BPMNShape id="pool_app_di" bpmnElement="pool_app" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="902" height="376" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_turnRequested_di" bpmnElement="evt_turnRequested">
        <dc:Bounds x="90" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="61" y="111" width="95" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_checkSpendingLimit_di" bpmnElement="task_checkSpendingLimit">
        <dc:Bounds x="176" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_limitAction_di" bpmnElement="gw_limitAction">
        <dc:Bounds x="326" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="307" y="46" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_showWarning_di" bpmnElement="task_showWarning">
        <dc:Bounds x="426" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_turnRefused_di" bpmnElement="evt_turnRefused">
        <dc:Bounds x="458" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="435" y="369" width="82" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_actionJoin_di" bpmnElement="gw_actionJoin">
        <dc:Bounds x="576" y="65" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_runTurn_di" bpmnElement="task_runTurn">
        <dc:Bounds x="676" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_turnFinished_di" bpmnElement="evt_turnFinished">
        <dc:Bounds x="826" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="111" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_turnRequested_to_checkSpendingLimit_di" bpmnElement="flow_turnRequested_to_checkSpendingLimit">
        <di:waypoint x="126" y="90" />
        <di:waypoint x="176" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkSpendingLimit_to_limitAction_di" bpmnElement="flow_checkSpendingLimit_to_limitAction">
        <di:waypoint x="276" y="90" />
        <di:waypoint x="326" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_limitAction_to_actionJoin_di" bpmnElement="flow_limitAction_to_actionJoin">
        <di:waypoint x="376" y="90" />
        <di:waypoint x="576" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="72" width="39" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_limitAction_to_showWarning_di" bpmnElement="flow_limitAction_to_showWarning">
        <di:waypoint x="351" y="115" />
        <di:waypoint x="351" y="230" />
        <di:waypoint x="426" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="357" y="212" width="33" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_limitAction_to_turnRefused_di" bpmnElement="flow_limitAction_to_turnRefused">
        <di:waypoint x="351" y="115" />
        <di:waypoint x="351" y="348" />
        <di:waypoint x="458" y="348" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="357" y="330" width="33" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_showWarning_to_actionJoin_di" bpmnElement="flow_showWarning_to_actionJoin">
        <di:waypoint x="526" y="230" />
        <di:waypoint x="601" y="230" />
        <di:waypoint x="601" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_actionJoin_to_runTurn_di" bpmnElement="flow_actionJoin_to_runTurn">
        <di:waypoint x="626" y="90" />
        <di:waypoint x="676" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_runTurn_to_turnFinished_di" bpmnElement="flow_runTurn_to_turnFinished">
        <di:waypoint x="776" y="90" />
        <di:waypoint x="826" y="90" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
