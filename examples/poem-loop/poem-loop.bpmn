<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_poemLoop" targetNamespace="https://monorail.invalid/diagrams/poem-loop">
  <bpmn:collaboration id="collab_poemLoop">
    <bpmn:participant id="pool_script" name="Python script" processRef="proc_poemLoop" />
    <bpmn:participant id="pool_codex" name="Codex CLI" />
    <bpmn:messageFlow id="msg_writerPrompt" name="Writer prompt" sourceRef="task_writePoem" targetRef="pool_codex" />
    <bpmn:messageFlow id="msg_poem" name="Poem" sourceRef="pool_codex" targetRef="task_writePoem" />
    <bpmn:messageFlow id="msg_poemToGrade" name="Poem to grade" sourceRef="task_gradePoem" targetRef="pool_codex" />
    <bpmn:messageFlow id="msg_scoreAndFeedback" name="Score and feedback" sourceRef="pool_codex" targetRef="task_gradePoem" />
    <bpmn:messageFlow id="msg_promptPoemGrade" name="Prompt, poem and grade" sourceRef="task_revisePrompt" targetRef="pool_codex" />
    <bpmn:messageFlow id="msg_newPrompt" name="New prompt" sourceRef="pool_codex" targetRef="task_revisePrompt" />
  </bpmn:collaboration>
  <bpmn:dataStore id="store_writerPrompt" name="Writer prompt" />
  <bpmn:process id="proc_poemLoop" isExecutable="false">
    <bpmn:documentation>Purpose: show how a script improves a writing prompt using three separate Codex runs (write, grade, revise). Trigger: the script is started.</bpmn:documentation>
    <bpmn:startEvent id="evt_scriptStarted" name="Script started" />
    <bpmn:subProcess id="sub_round" name="Round">
      <bpmn:documentation>Repeats three times.</bpmn:documentation>
      <bpmn:standardLoopCharacteristics loopMaximum="3" />
      <bpmn:startEvent id="evt_roundStarted" name="Round started" />
      <bpmn:serviceTask id="task_writePoem" name="Write poem">
        <bpmn:dataInputAssociation id="assoc_writerPromptToWrite">
          <bpmn:sourceRef>data_writerPrompt</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="task_gradePoem" name="Grade poem" />
      <bpmn:serviceTask id="task_revisePrompt" name="Revise prompt">
        <bpmn:dataOutputAssociation id="assoc_reviseToWriterPrompt">
          <bpmn:targetRef>data_writerPrompt</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="evt_promptRevised" name="Prompt revised" />
      <bpmn:sequenceFlow id="flow_roundStarted_to_writePoem" sourceRef="evt_roundStarted" targetRef="task_writePoem" />
      <bpmn:sequenceFlow id="flow_writePoem_to_gradePoem" sourceRef="task_writePoem" targetRef="task_gradePoem" />
      <bpmn:sequenceFlow id="flow_gradePoem_to_revisePrompt" sourceRef="task_gradePoem" targetRef="task_revisePrompt" />
      <bpmn:sequenceFlow id="flow_revisePrompt_to_promptRevised" sourceRef="task_revisePrompt" targetRef="evt_promptRevised" />
    </bpmn:subProcess>
    <bpmn:endEvent id="evt_promptImproved" name="Prompt improved" />
    <bpmn:dataStoreReference id="data_writerPrompt" name="Writer prompt" dataStoreRef="store_writerPrompt" />
    <bpmn:sequenceFlow id="flow_scriptStarted_to_round" sourceRef="evt_scriptStarted" targetRef="sub_round" />
    <bpmn:sequenceFlow id="flow_round_to_promptImproved" sourceRef="sub_round" targetRef="evt_promptImproved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_collab_poemLoop">
    <bpmndi:BPMNPlane id="plane_collab_poemLoop" bpmnElement="collab_poemLoop">
      <bpmndi:BPMNShape id="pool_script_di" bpmnElement="pool_script" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="882" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_scriptStarted_di" bpmnElement="evt_scriptStarted">
        <dc:Bounds x="80" y="208" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="51" y="247" width="95" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_round_di" bpmnElement="sub_round" isExpanded="true">
        <dc:Bounds x="166" y="150" width="620" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_roundStarted_di" bpmnElement="evt_roundStarted">
        <dc:Bounds x="190" y="208" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="181" y="247" width="54" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_writePoem_di" bpmnElement="task_writePoem">
        <dc:Bounds x="276" y="186" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_gradePoem_di" bpmnElement="task_gradePoem">
        <dc:Bounds x="426" y="186" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_revisePrompt_di" bpmnElement="task_revisePrompt">
        <dc:Bounds x="576" y="186" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_promptRevised_di" bpmnElement="evt_promptRevised">
        <dc:Bounds x="726" y="208" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="717" y="247" width="54" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_promptImproved_di" bpmnElement="evt_promptImproved">
        <dc:Bounds x="836" y="208" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="804" y="247" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_writerPrompt_di" bpmnElement="data_writerPrompt">
        <dc:Bounds x="451" y="60" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="507" y="77" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_codex_di" bpmnElement="pool_codex" isHorizontal="true">
        <dc:Bounds x="20" y="430" width="882" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_scriptStarted_to_round_di" bpmnElement="flow_scriptStarted_to_round">
        <di:waypoint x="116" y="226" />
        <di:waypoint x="166" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_round_to_promptImproved_di" bpmnElement="flow_round_to_promptImproved">
        <di:waypoint x="786" y="226" />
        <di:waypoint x="836" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_roundStarted_to_writePoem_di" bpmnElement="flow_roundStarted_to_writePoem">
        <di:waypoint x="226" y="226" />
        <di:waypoint x="276" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_writePoem_to_gradePoem_di" bpmnElement="flow_writePoem_to_gradePoem">
        <di:waypoint x="376" y="226" />
        <di:waypoint x="426" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gradePoem_to_revisePrompt_di" bpmnElement="flow_gradePoem_to_revisePrompt">
        <di:waypoint x="526" y="226" />
        <di:waypoint x="576" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_revisePrompt_to_promptRevised_di" bpmnElement="flow_revisePrompt_to_promptRevised">
        <di:waypoint x="676" y="226" />
        <di:waypoint x="726" y="226" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="assoc_writerPromptToWrite_di" bpmnElement="assoc_writerPromptToWrite">
        <di:waypoint x="476" y="110" />
        <di:waypoint x="476" y="136" />
        <di:waypoint x="326" y="136" />
        <di:waypoint x="326" y="186" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="assoc_reviseToWriterPrompt_di" bpmnElement="assoc_reviseToWriterPrompt">
        <di:waypoint x="626" y="186" />
        <di:waypoint x="626" y="126" />
        <di:waypoint x="476" y="126" />
        <di:waypoint x="476" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_writerPrompt_di" bpmnElement="msg_writerPrompt">
        <di:waypoint x="318" y="266" />
        <di:waypoint x="318" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="223" y="340" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_poem_di" bpmnElement="msg_poem">
        <di:waypoint x="334" y="430" />
        <di:waypoint x="334" y="266" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="340" y="340" width="33" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_poemToGrade_di" bpmnElement="msg_poemToGrade">
        <di:waypoint x="492" y="266" />
        <di:waypoint x="492" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="397" y="340" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_scoreAndFeedback_di" bpmnElement="msg_scoreAndFeedback">
        <di:waypoint x="508" y="430" />
        <di:waypoint x="508" y="266" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="333" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_promptPoemGrade_di" bpmnElement="msg_promptPoemGrade">
        <di:waypoint x="618" y="266" />
        <di:waypoint x="618" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="365" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="msg_newPrompt_di" bpmnElement="msg_newPrompt">
        <di:waypoint x="634" y="430" />
        <di:waypoint x="634" y="266" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="340" width="70" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
