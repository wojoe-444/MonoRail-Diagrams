<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_connectionCheck" targetNamespace="https://monorail.invalid/diagrams/connection-check">
  <bpmn:collaboration id="collab_connectionCheck">
    <bpmn:participant id="pool_app" name="MonoRail app" processRef="proc_connectionCheck" />
  </bpmn:collaboration>
  <bpmn:process id="proc_connectionCheck" isExecutable="false">
    <bpmn:documentation>Purpose: show when the Connections page checks a connection and when it runs nothing for it. Trigger: something that can prompt a check happens for one connection (page opened, Check, Check all, window focus, app start).</bpmn:documentation>
    <bpmn:startEvent id="evt_triggerOccurred" name="Trigger occurred" />
    <bpmn:businessRuleTask id="task_decideCheckAction" name="Decide check action" implementation="connection-check-action.dmn#dec_connectionCheckAction" />
    <bpmn:exclusiveGateway id="gw_checkAction" name="Check action?" />
    <bpmn:serviceTask id="task_checkConnection" name="Check connection" />
    <bpmn:endEvent id="evt_connectionChecked" name="Connection checked" />
    <bpmn:endEvent id="evt_connectionNotChecked" name="Connection not checked" />
    <bpmn:sequenceFlow id="flow_triggerOccurred_to_decideCheckAction" sourceRef="evt_triggerOccurred" targetRef="task_decideCheckAction" />
    <bpmn:sequenceFlow id="flow_decideCheckAction_to_checkAction" sourceRef="task_decideCheckAction" targetRef="gw_checkAction" />
    <bpmn:sequenceFlow id="flow_checkAction_to_checkConnection" name="check" sourceRef="gw_checkAction" targetRef="task_checkConnection" />
    <bpmn:sequenceFlow id="flow_checkAction_to_connectionNotChecked" name="skip" sourceRef="gw_checkAction" targetRef="evt_connectionNotChecked" />
    <bpmn:sequenceFlow id="flow_checkConnection_to_connectionChecked" sourceRef="task_checkConnection" targetRef="evt_connectionChecked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_collab_connectionCheck">
    <bpmndi:BPMNPlane id="plane_collab_connectionCheck" bpmnElement="collab_connectionCheck">
      <bpmndi:BPMNShape id="pool_app_di" bpmnElement="pool_app" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="612" height="236" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_triggerOccurred_di" bpmnElement="evt_triggerOccurred">
        <dc:Bounds x="80" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="48" y="111" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_decideCheckAction_di" bpmnElement="task_decideCheckAction">
        <dc:Bounds x="166" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_checkAction_di" bpmnElement="gw_checkAction">
        <dc:Bounds x="316" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="297" y="46" width="89" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_checkConnection_di" bpmnElement="task_checkConnection">
        <dc:Bounds x="416" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_connectionNotChecked_di" bpmnElement="evt_connectionNotChecked">
        <dc:Bounds x="448" y="190" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="416" y="229" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evt_connectionChecked_di" bpmnElement="evt_connectionChecked">
        <dc:Bounds x="566" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="534" y="111" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_triggerOccurred_to_decideCheckAction_di" bpmnElement="flow_triggerOccurred_to_decideCheckAction">
        <di:waypoint x="116" y="90" />
        <di:waypoint x="166" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_decideCheckAction_to_checkAction_di" bpmnElement="flow_decideCheckAction_to_checkAction">
        <di:waypoint x="266" y="90" />
        <di:waypoint x="316" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkAction_to_checkConnection_di" bpmnElement="flow_checkAction_to_checkConnection">
        <di:waypoint x="366" y="90" />
        <di:waypoint x="416" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370" y="72" width="39" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkAction_to_connectionNotChecked_di" bpmnElement="flow_checkAction_to_connectionNotChecked">
        <di:waypoint x="341" y="115" />
        <di:waypoint x="341" y="208" />
        <di:waypoint x="448" y="208" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="347" y="190" width="33" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkConnection_to_connectionChecked_di" bpmnElement="flow_checkConnection_to_connectionChecked">
        <di:waypoint x="516" y="90" />
        <di:waypoint x="566" y="90" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
